#!/bin/sh
set -eu

echo "Checking generated website files before push..."

if ! python3 scripts/check_site.py; then
  echo >&2
  echo "Push stopped: the website is not ready to deploy." >&2
  echo "Run 'python3 scripts/check_site.py --fix', review and commit the generated files, then push again." >&2
  exit 1
fi

