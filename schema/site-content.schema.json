{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal website content",
  "type": "object",
  "required": ["homeHighlights", "blogTagOptions", "blogSeriesOptions", "publications", "honors", "activities", "blogPosts"],
  "additionalProperties": false,
  "properties": {
    "homeHighlights": {
      "type": "array",
      "items": { "$ref": "#/$defs/homeHighlight" }
    },
    "blogTagOptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/tag" }
    },
    "blogSeriesOptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/tag" }
    },
    "publications": {
      "type": "array",
      "items": { "$ref": "#/$defs/publication" }
    },
    "honors": {
      "type": "object",
      "required": ["awards", "talks", "presentations", "mediaCoverage", "services"],
      "properties": {
        "awards": {
          "type": "array",
          "items": { "$ref": "#/$defs/honorItem" }
        },
        "talks": {
          "type": "array",
          "items": { "$ref": "#/$defs/honorItem" }
        },
        "presentations": {
          "type": "array",
          "items": { "$ref": "#/$defs/honorItem" }
        },
        "mediaCoverage": {
          "type": "array",
          "items": { "$ref": "#/$defs/mediaItem" }
        },
        "services": {
          "type": "array",
          "items": { "$ref": "#/$defs/serviceItem" }
        }
      }
    },
    "activities": {
      "type": "array",
      "items": { "$ref": "#/$defs/activity" }
    },
    "blogPosts": {
      "type": "array",
      "items": { "$ref": "#/$defs/blogPost" }
    }
  },
  "$defs": {
    "tag": {
      "type": "object",
      "required": ["slug", "label"],
      "properties": {
        "slug": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "group": { "type": "string" }
      }
    },
    "link": {
      "type": "object",
      "required": ["label", "href"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "href": { "type": "string", "minLength": 1 }
      }
    },
    "homeHighlight": {
      "type": "object",
      "required": ["meta", "title", "description"],
      "properties": {
        "meta": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "href": { "type": "string" }
      }
    },
    "publication": {
      "type": "object",
      "required": ["year", "title", "category", "authors", "venue"],
      "properties": {
        "year": { "type": "string", "pattern": "^[0-9]{4}$" },
        "title": { "type": "string", "minLength": 1 },
        "category": { "type": "string" },
        "authors": { "type": "string" },
        "venue": { "type": "string" },
        "doi": { "type": "string" },
        "summary": { "type": "string" },
        "firstAuthor": { "type": "boolean" },
        "correspondingAuthor": { "type": "boolean" },
        "featured": { "type": "boolean" },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/tag" }
        }
      }
    },
    "honorItem": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "year": { "type": "string" },
        "date": { "type": "string" },
        "dateLabel": { "type": "string" },
        "scope": { "type": "string", "enum": ["international", "domestic"] },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        }
      }
    },
    "mediaItem": {
      "allOf": [{ "$ref": "#/$defs/honorItem" }]
    },
    "serviceItem": {
      "type": "object",
      "required": ["title"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "items": {
          "type": "array",
          "items": { "type": ["string", "object"] }
        },
        "memberships": {
          "type": "array",
          "items": { "type": ["string", "object"] }
        },
        "links": {
          "type": "array",
          "items": { "$ref": "#/$defs/link" }
        }
      }
    },
    "activityImage": {
      "type": "object",
      "required": ["src"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string" },
        "caption": { "type": "string" }
      }
    },
    "activity": {
      "type": "object",
      "required": ["id", "title", "summary"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "date": { "type": "string" },
        "dateLabel": { "type": "string" },
        "year": { "type": "string" },
        "meta": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "summary": { "type": "string" },
        "body": {
          "type": "array",
          "items": { "type": "string" }
        },
        "visualLabel": { "type": "string" },
        "visualTheme": { "type": "string" },
        "image": { "type": "string" },
        "imageAlt": { "type": "string" },
        "images": {
          "type": "array",
          "items": { "$ref": "#/$defs/activityImage" }
        },
        "featured": { "type": "boolean" },
        "log": { "type": "boolean" }
      }
    },
    "blogPost": {
      "type": "object",
      "required": ["id", "status", "date", "title", "excerpt", "body"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "status": { "enum": ["published", "draft"] },
        "date": { "type": "string" },
        "dateLabel": { "type": "string" },
        "title": { "type": "string", "minLength": 1 },
        "excerpt": { "type": "string" },
        "image": { "type": "string" },
        "imageAlt": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "$ref": "#/$defs/tag" }
        },
        "series": {
          "anyOf": [
            { "$ref": "#/$defs/tag" },
            { "type": "null" }
          ]
        },
        "body": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
